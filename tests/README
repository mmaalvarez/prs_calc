## based on PGS000392 PRS model

# Generate the files

chmod +x make_prs_calc_toy.py
./make_prs_calc_toy.py prs_calc_toy

"""
It creates:

text
prs_calc_toy/
├── PGS000392_hg19.txt
├── samplesheet.tsv
├── phenotypes.tsv
├── expected_scores.tsv
├── genotype_design.tsv
├── extra_variants.tsv
└── vcfs/
    ├── sample1.vcf.gz
    ├── sample1.vcf.gz.tbi
    ├── ...
    ├── sample10.vcf.gz
    └── sample10.vcf.gz.tbi

Run the pipeline
Use hg19, not hg37, because the score column is named chr_position_hg19:
"""

nextflow run "PWD/../main.nf" \
    --input "$PWD/prs_calc_toy/samplesheet.tsv" \
    --scorefile "$PWD/prs_calc_toy/PGS000392_hg19.txt" \
    --phenotypes "$PWD/prs_calc_toy/phenotypes.tsv" \
    --target_build hg19 \
    -profile conda \
    -resume

"""
Or use -profile mamba if appropriate.

To create the conda environment with the required packages, first run:
```
wget https://github.com/mmaalvarez/prs_calc/blob/main/envs/prs_calc.yml

conda env create -f prs_calc.yml -n prs_calc
```

Expected raw additive scores:
  sample1 case    score=6.1652982550894038 dosage=38 omitted=0
  sample2 case    score=5.6640279157457166 dosage=34 omitted=2
  sample3 control score=0.0000000000000000 dosage=0 omitted=0
  sample4 case    score=4.2069182887323967 dosage=22 omitted=1
  sample5 control score=0.6801616757074487 dosage=6 omitted=2
  sample6 control score=2.2904895397688336 dosage=19 omitted=15
  sample7 case    score=3.0826491275447019 dosage=19 omitted=0
  sample8 control score=0.5943844082022270 dosage=5 omitted=2
  sample9 case    score=5.4616500983979826 dosage=33 omitted=1
  sample10 control score=2.3663344026541638 dosage=20 omitted=19


Thus every designed case scores above every control. The expected ROC AUC is therefore approximately 1.0.

You can verify the key 13:32972626 A>T genotype with:
"""

for file in prs_calc_toy/vcfs/*.vcf.gz; do
    sample=$(basename "$file" .vcf.gz)
    printf '%s\t' "$sample"
    bcftools query \
        -r 13:32972626-32972626 \
        -f '[%GT]\n' \
        "$file"
done

"""
Expected output:

text
sample1	1/1
sample2	1/1
sample3	0/0
sample4	1/1
sample5	0/0
sample6	0/0
...

With only ten deliberately separated samples, the ROC plot is useful as a smoke test, but odds ratios by decile will be statistically meaningless and may be infinite because of perfect separation.
"""
