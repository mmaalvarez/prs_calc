/*
 * Main configuration for prs_calc.
 */

params {
    input                = null
    gvcf_mode            = 'auto'
    scorefile            = null
    min_covered_fraction = 0
    
    /*
     * hard : use called GT allele counts.
     * soft : use FORMAT/GP when available; otherwise use GT.
     */
    genotype_calls = 'hard'

    /*
     * When true, effect_genotype is required in the score table.
     * The multiplier is membership in that explicit genotype set,
     * or its probability when soft calls are used.
     */
    non_additive = false

    /*
     * Optional headerless TSV containing:
     * sample_id<TAB>case|control
     *
     * When omitted, cohort ROC and odds-ratio plots are not generated.
     */
    phenotypes          = null

    /*
     * Accepted values: i) hg38, GRCh38, and 38; b) hg19, GRCh37, and 19.
     * --hg is retained as an optional alias.
     */
    target_build        = 'hg38'
    hg                  = null

    outdir              = "${launchDir}/results"
    publish_dir_mode    = 'copy'

    /*
     * Required for every run.
     *
     * reference : for absent score SNPs in plain VCFs only, assume the
     *             configured ploidy of BSgenome reference alleles
     * zero      : assign zero effect-allele dosage to absent score SNPs
     * error     : abort at the first absent score SNP
     *
     * An observed hom-ref gVCF block is always scored as hom-ref,
     * independently of this setting.
     */
    missing_genotype    = null
    default_ploidy      = 2

    /*
     * Required for every run.
     *
     * zero  : full no-calls contribute zero; for partially missing GTs,
     *         count known effect-allele copies and give missing copies
     *         zero dosage.
     * error : abort on full or partially missing GTs.
     *
     * Partially missing reference-only intervals with END > POS remain
     * unsupported.
     */
    no_calls = null

    /*
     * Fail when score alleles do not agree with the selected reference genome.
     * Return a warning when the VCF REF does not agree with it.
     * WARNING: It enforces observed score/VCF compatibility, not universal 
     * score/BSgenome compatibility: an absent score row assigned zero can have 
     * neither score allele matching BSgenome and still pass.
     * 'true' is required, 'false' is not supported.
     */
    strict_alleles      = true

    plot_top_variants   = 25

    traceTimestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

cleanup = false

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled = true
    }

    mamba {
        conda.enabled  = true
        conda.useMamba = true
    }

    slurm {
        process.executor = 'slurm'
    }

    debug {
        dumpHashes   = true
        cleanup      = false
        process.beforeScript = 'echo "Host: $HOSTNAME"'
    }
}

env {
    PYTHONNOUSERSITE = '1'
    R_PROFILE_USER   = '/dev/null'
    R_ENVIRON_USER   = '/dev/null'
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

process {
    withLabel: 'prs_calc_env' {
        conda = "${projectDir}/envs/prs_calc.yml"
    }
}

executor {
    exitReadTimeout = '270 sec'
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${params.traceTimestamp}.html"
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${params.traceTimestamp}.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${params.traceTimestamp}.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${params.traceTimestamp}.html"
}

manifest {
    name            = 'mmaalvarez/prs_calc'
    author          = 'Miguel Martín Álvarez'
    defaultBranch   = 'main'
    homePage        = 'https://github.com/mmaalvarez/prs_calc'
    description     = 'Nextflow pipeline for polygenic risk score calculation'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
