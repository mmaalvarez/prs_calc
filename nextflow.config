/*
 * Main configuration for prs_calc.
 */

def traceTimestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

params {
    input               = null
    scorefile           = null

    /*
     * Optional headerless TSV containing:
     * sample_id<TAB>case|control
     *
     * When omitted, cohort ROC and odds-ratio plots are not generated.
     */
    phenotypes          = null

    /*
     * Accepted values: hg38, hg37, hg19, 38, 37 or 19.
     * --hg is retained as an optional alias.
     */
    target_build        = 'hg38'
    hg                  = null

    outdir              = "${launchDir}/results"
    publish_dir_mode    = 'copy'

    /*
     * Handling of loci that are absent from the VCF or have a no-call GT:
     *
     * reference : assume the configured ploidy of reference alleles
     * zero      : assign zero effect alleles
     * error     : stop the pipeline
     */
    missing_genotype    = 'reference'
    default_ploidy      = 2

    /*
     * Fail when score alleles do not agree with the selected reference
     * genome or when the VCF REF does not agree with it.
     */
    strict_alleles      = true

    plot_top_variants   = 25
}

cleanup = false

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled = true
    }

    mamba {
        conda.enabled  = true
        conda.useMamba = true
    }

    slurm {
        process.executor = 'slurm'
    }

    debug {
        dumpHashes   = true
        cleanup      = false
        process.beforeScript = 'echo "Host: $HOSTNAME"'
    }
}

env {
    PYTHONNOUSERSITE = '1'
    R_PROFILE_USER   = '/dev/null'
    R_ENVIRON_USER   = '/dev/null'
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

executor {
    exitReadTimeout = '270 sec'
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${traceTimestamp}.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${traceTimestamp}.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${traceTimestamp}.txt"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${traceTimestamp}.html"
}

manifest {
    name            = 'mmaalvarez/prs_calc'
    author          = 'Miguel Martín Álvarez'
    defaultBranch   = 'main'
    homePage        = 'https://github.com/mmaalvarez/prs_calc'
    description     = 'Nextflow pipeline for polygenic risk score calculation'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
